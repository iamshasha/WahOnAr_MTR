+package org.mtr.legacy.data;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+/**
+ * Covers what speed a rail from an MTR 3 world converts to.
+ *
+ * The failure this guards against is silent: an unrecognised type name resolves to WOODEN at 20 km/h, and since
+ * the name was the only record of what the rail was, nothing afterwards can tell that it happened. So the cases
+ * that matter most here are the ones where the answer must NOT be 20.
+ */
+public final class LegacyRailSpeedTests {
+
+	@Test
+	public void savedSpeedWins() {
+		// MTR 3.4.0 and later write the rail's speed onto the rail. A builder may also have set it by hand, so
+		// it beats anything the type name says -- including for types that have a speed of their own.
+		assertEquals(450, speed("NETHERITE", 450, DataFixer.RailType.NETHERITE));
+		assertEquals(30, speed("NETHERITE", 30, DataFixer.RailType.NETHERITE));
+		assertEquals(140, speed("IRON", 140, DataFixer.RailType.IRON));
+		// ...and it is the only thing left when the name means nothing to any build
+		assertEquals(275, speed("SOME_TYPE_NOBODY_HAS", 275, DataFixer.RailType.WOODEN));
+	}
+
+	@Test
+	public void absorbedTypesKeepTheirSpeed() {
+		// The five from the retired High Speed Rails addon, in a world saved before 3.4.0 stamped them
+		assertEquals(450, speed("NETHERITE", 0, DataFixer.RailType.NETHERITE));
+		assertEquals(500, speed("PURPUR", 0, DataFixer.RailType.PURPUR));
+		assertEquals(600, speed("REINFORCED_DEEPSLATE", 0, DataFixer.RailType.REINFORCED_DEEPSLATE));
+		assertEquals(700, speed("BARRIER", 0, DataFixer.RailType.BARRIER));
+		assertEquals(800, speed("BEDROCK", 0, DataFixer.RailType.BEDROCK));
+	}
+
+	@Test
+	public void syntheticTypesSpellTheirSpeed() {
+		// MTR-ANTE builds these at runtime, one per km/h, so there is no list of them to match against
+		assertEquals(160, speed("P160", 0, DataFixer.RailType.WOODEN));
+		assertEquals(1, speed("P1", 0, DataFixer.RailType.WOODEN));
+		assertEquals(10000, speed("P10000", 0, DataFixer.RailType.WOODEN));
+	}
+
+	@Test
+	public void nothingElseIsGuessedAt() {
+		// P-1 is ANTE's name for a rail with no limit at all, not a rail at -1 km/h
+		assertEquals(20, speed("P-1", 0, DataFixer.RailType.WOODEN));
+		// A name that merely looks like one is not one
+		assertEquals(80, speed("PLATFORM", 0, DataFixer.RailType.PLATFORM));
+		assertEquals(300, speed("P", 0, DataFixer.RailType.DIAMOND));
+		assertEquals(60, speed("P12X", 0, DataFixer.RailType.EMERALD));
+		// An ordinary rail is left entirely alone
+		assertEquals(80, speed("IRON", 0, DataFixer.RailType.IRON));
+		assertEquals(0, speed("NONE", 0, DataFixer.RailType.NONE));
+	}
+
+	private static int speed(String savedRailTypeName, long savedSpeedLimit, DataFixer.RailType railType) {
+		return DataFixer.legacySpeedLimitKilometersPerHour(savedRailTypeName, savedSpeedLimit, railType);
+	}
+}
