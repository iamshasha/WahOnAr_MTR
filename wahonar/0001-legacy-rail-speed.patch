+++ b/src/main/java/org/mtr/legacy/data/DataFixer.java
@@ -20,6 +20,8 @@ import org.mtr.core.tool.Utilities;
 
 import java.util.Locale;
 import java.util.function.BiConsumer;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
 import java.util.function.Consumer;
 
 @Log4j2
@@ -239,6 +241,36 @@ public final class DataFixer {
 		}
 	}
 
+	/**
+	 * Rail types added at runtime by MTR-ANTE, one per km/h: P-1 to P600, then P1000 to P10000 in steps of 500.
+	 *
+	 * They exist only inside a running game, so no list of them can be kept here; the speed is in the name.
+	 */
+	private static final Pattern SYNTHETIC_RAIL_TYPE = Pattern.compile("P(-?\\d+)");
+
+	/**
+	 * The speed a legacy rail should run at, in km/h.
+	 *
+	 * Resolving the type by name and taking its speed is not enough on its own. A name this class does not know
+	 * falls back to WOODEN, at 20 km/h -- silently, and unrecoverably, since the name was the only record of what
+	 * the rail was. That is what happens to every rail an addon contributed. Two things are tried before the
+	 * fallback is accepted: the speed the rail saved on itself, which MTR 3.4.0 and later write out precisely so
+	 * that it outlives the name, and the speed spelled out in the name of a synthetic type.
+	 */
+	public static int legacySpeedLimitKilometersPerHour(String savedRailTypeName, long savedSpeedLimitKilometersPerHour, RailType railType) {
+		if (savedSpeedLimitKilometersPerHour > 0) {
+			return (int) savedSpeedLimitKilometersPerHour;
+		}
+		final Matcher matcher = SYNTHETIC_RAIL_TYPE.matcher(savedRailTypeName);
+		if (matcher.matches()) {
+			final int speedLimit = Integer.parseInt(matcher.group(1));
+			if (speedLimit > 0) {
+				return speedLimit;
+			}
+		}
+		return railType.speedLimitKilometersPerHour;
+	}
+
 	public enum RailType {
 		WOODEN(20, false, true, true, Rail.Shape.QUADRATIC),
 		STONE(40, false, true, true, Rail.Shape.QUADRATIC),
@@ -255,7 +287,14 @@ public final class DataFixer {
 		CABLE_CAR_STATION(2, false, true, true, Rail.Shape.QUADRATIC),
 		RUNWAY(300, false, true, false, Rail.Shape.QUADRATIC),
 		AIRPLANE_DUMMY(SidingPathFinder.AIRPLANE_SPEED, false, true, false, Rail.Shape.QUADRATIC),
-		NONE(0, false, false, true, Rail.Shape.QUADRATIC);
+		NONE(0, false, false, true, Rail.Shape.QUADRATIC),
+		// Absorbed into the Wah On Ar build of MTR 3 from the High Speed Rails addon, which is unmaintained. A
+		// world saved by that build names these, and without them every such rail converts to WOODEN at 20 km/h.
+		NETHERITE(450, false, true, true, Rail.Shape.QUADRATIC),
+		PURPUR(500, false, true, true, Rail.Shape.QUADRATIC),
+		REINFORCED_DEEPSLATE(600, false, true, true, Rail.Shape.QUADRATIC),
+		BARRIER(700, false, true, true, Rail.Shape.QUADRATIC),
+		BEDROCK(800, false, true, true, Rail.Shape.QUADRATIC);
 
 		public final int speedLimitKilometersPerHour;
 		public final double speedLimitMetersPerMillisecond;
